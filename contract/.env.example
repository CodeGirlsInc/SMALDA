# ──────────────────────────────────────────────────────────────
# Contract Service Configuration
# Copy this file to .env and fill in the values.
# All variables have sensible defaults where marked [default: ...].
# ──────────────────────────────────────────────────────────────

# Port the HTTP server listens on.                         [default: 8080]
PORT=8080

# Stellar Horizon API endpoint.                              [default: https://horizon-testnet.stellar.org]
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar secret key for signing transactions (56 chars, starts with 'S').
# Required – the service will not start without it.
STELLAR_SECRET_KEY=

# Stellar network the service signs for.
# Valid values: "testnet", "mainnet"                        [default: testnet]
# STELLAR_NETWORK=testnet

# Redis connection URL.                                     [default: redis://127.0.0.1:6379]
REDIS_URL=redis://127.0.0.1:6379

# Sustained verification/other-route quota (requests per second). [default: 10]
RATE_LIMIT_PER_SECOND=10

# Burst quota for verification/other routes.               [default: 10]
RATE_LIMIT_BURST=10

# Lower, independent quota for Stellar document submissions.
SUBMIT_RATE_LIMIT_PER_SECOND=1
SUBMIT_RATE_LIMIT_BURST=2

# Maximum number of retries for Stellar Horizon requests.   [default: 3]
STELLAR_MAX_RETRIES=3

# Initial back-off applied to the first retry of a Horizon call (ms).
# Grows exponentially between retries.                       [default: 200]
HORIZON_RETRY_INITIAL_BACKOFF_MS=200

# Consecutive Horizon failures (5xx, 429, transport timeouts) that
# trip the circuit breaker into the Open state.             [default: 5]
HORIZON_CB_FAILURE_THRESHOLD=5

# How long the breaker remains Open before admitting a single
# HalfOpen probe (seconds).                                 [default: 30]
HORIZON_CB_COOLDOWN_SECS=30

# Log verbosity.                                            [default: info]
LOG_LEVEL=info

# Comma-separated list of webhook callback URLs.            [default: empty]
WEBHOOK_URLS=

# Secret used to validate incoming webhook signatures.      [default: none]
WEBHOOK_SECRET=

# TTL (seconds) for cached verification results.            [default: 3600]
CACHE_VERIFICATION_TTL=3600
